APP_NAME="AI Air Quality Monitoring API"
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aqi_monitoring
POSTGRES_USER=aqi_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://aqi_user:change-me@postgres:5432/aqi_monitoring

JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
LOG_LEVEL=INFO

OPEN_METEO_TIMEOUT_SECONDS=10
OPEN_METEO_RETRY_COUNT=3
OPEN_METEO_RETRY_BACKOFF_SECONDS=1.0

APP_NAME="AI Air Quality Monitoring API"
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=aqi_prediction

JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
LOG_LEVEL=INFO

OPEN_METEO_TIMEOUT_SECONDS=10
OPEN_METEO_RETRY_COUNT=3
OPEN_METEO_RETRY_BACKOFF_SECONDS=1.0

# OpenAQ & WAQI / CPCB API
OPENAQ_API_KEY="a15d33c429b062acffad8440c9ce6823484724a9dafcf916f345a6ed09d72abd"
WAQI_API_TOKEN=""

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL_SECONDS=86400

# Groq API & Search AQI Toggle
USE_GROQ_AQI=true
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

